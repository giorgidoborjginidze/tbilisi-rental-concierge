// Prisma schema — STR / Aparthotel Operator Tool (Phase 1)
//
// Runs on SQLite locally. Kept Postgres-compatible for a later switch:
// no SQLite-only features; enum-like fields are Strings (documented below);
// money is Float for SQLite (switch to Decimal when moving to Postgres).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// The account/customer: a professional STR/aparthotel operator.
model Operator {
  id           String   @id @default(cuid())
  name         String? // optional — display name only; never required
  email        String   @unique
  passwordHash String? // scrypt "salt:hash"; null only for legacy rows
  locale       String   @default("en") // "en" | "ka"
  createdAt    DateTime @default(now())

  // Billing: 30-day full-access trial from signup, then a chosen plan.
  // Payments land in a later stage — choosing a plan activates it.
  accountType String    @default("personal") // "personal" | "business"
  // Workspace profile: shapes the dashboard and nav.
  profile     String    @default("personal") // "personal" | "hotel" | "brokerage"
  plan        String? // "starter" | "standard" | "pro" | "biz_s" | "biz_m"
  trialEndsAt DateTime?
  planSetAt   DateTime?
  // Subscription paid through this date (set on a successful payment).
  paidUntil   DateTime?

  // Team (business accounts): members belong to an owner's company and
  // enter their own listings; limits are counted company-wide.
  companyId String?
  role      String  @default("owner") // "owner" | "member"
  company   Operator?  @relation("Team", fields: [companyId], references: [id], onDelete: SetNull)
  members   Operator[] @relation("Team")

  // WhatsApp number that receives owner-side alerts (geofence, overdue rent).
  notifyPhone String?

  units     Unit[]
  alerts    Alert[]
  assets    Asset[]
  incomes   IncomeRecord[]
  sessions  Session[]
  invites   Invite[]
  payments  Payment[]
  templates NotifyTemplate[]
  messages  NotifyMessage[]

  @@index([companyId])
}

// A subscription payment attempt through a payment provider (Flitt).
// One row per checkout; status advances to "approved" via the provider's
// server callback, which is when the plan is actually activated.
model Payment {
  id          String    @id @default(cuid())
  operatorId  String
  provider    String    @default("flitt")
  plan        String // plan id being purchased
  amountMinor Int // amount in minor units (tetri) — 49 GEL = 4900
  currency    String    @default("GEL")
  // "pending" → "approved" | "declined". Activation happens on "approved".
  status      String    @default("pending")
  orderId     String    @unique // our id sent to the provider
  providerRef String? // provider's payment id (from the callback)
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

// A pending team invitation (business plans). The invite link is
// /register?invite=<token>; no email sending yet — the owner copies it.
model Invite {
  id        String    @id @default(cuid())
  companyId String
  email     String
  token     String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  company Operator @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// A login session; id is the SHA-256 of the cookie token.
model Session {
  id         String   @id
  operatorId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

// A rentable unit (apartment, aparthotel room, studio...).
model Unit {
  id              String   @id @default(cuid())
  operatorId      String
  name            String
  nameKa          String? // Georgian display name
  city            String   @default("Tbilisi") // "Tbilisi" | "Batumi"
  district        String // e.g. "Vake", "Vera", "Saburtalo", "Old Town", "Mtatsminda", "Batumi Boulevard"
  address         String
  type            String // "apartment" | "aparthotel_room" | "studio" | "house"
  capacity        Int
  bedrooms        Int
  baseNightlyRate Float
  currency        String   @default("GEL")
  amenities       Json // string[] of amenity keys
  channelLinks    Json // { airbnbUrl?, bookingUrl?, icalUrls: string[] }
  createdAt       DateTime @default(now())

  operator           Operator            @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  bookings           Booking[]
  leases             Lease[]
  pricingSuggestions PricingSuggestion[]
  alerts             Alert[]
  asset              Asset?

  @@index([operatorId])
  @@index([district])
}

// A short-term booking, imported from an iCal feed or entered manually.
// Guest PII kept minimal: guestName is optional (Georgian PDP law / GDPR).
model Booking {
  id         String   @id @default(cuid())
  unitId     String
  source     String // "airbnb" | "booking" | "direct" | "manual"
  guestName  String?
  checkIn    DateTime
  checkOut   DateTime
  nights     Int
  amount     Float?
  currency   String   @default("GEL")
  status     String   @default("confirmed") // "confirmed" | "cancelled" | "tentative"
  externalId String? // UID from the iCal event, used for dedupe
  importedAt DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, source, externalId])
  @@index([unitId, checkIn])
}

// A long-stay contract (aparthotel monthly stays / leases).
model Lease {
  id          String   @id @default(cuid())
  unitId      String
  tenantName  String?
  tenantPhone String? // for WhatsApp (door codes, notifications)
  startDate   DateTime
  endDate     DateTime
  monthlyRent Float
  currency    String   @default("GEL")
  status      String   @default("active") // "active" | "ended" | "upcoming"
  createdAt   DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, endDate])
}

// Output of the rule-based pricing engine, one row per unit per date.
model PricingSuggestion {
  id            String   @id @default(cuid())
  unitId        String
  date          DateTime
  suggestedRate Float
  currency      String   @default("GEL")
  reasons       Json // { factors: {...}, rationale: string }
  createdAt     DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, date])
}

// Neighborhood ADR / occupancy reference, per district per month.
// MVP rows are mock data behind the pluggable MarketDataSource interface.
model MarketBenchmark {
  id            String @id @default(cuid())
  district      String
  month         String // "YYYY-MM"
  adr           Float
  occupancyRate Float // 0..1
  sampleSize    Int
  source        String @default("mock")

  @@unique([district, month])
}

// A personal asset: real estate (apartment, house, commercial, land,
// garage) or movable property (vehicle, equipment). Tracks status,
// estimated value, and — via RentalContract — who rents it and until when.
model Asset {
  id             String   @id @default(cuid())
  operatorId     String
  name           String
  nameKa         String?
  category       String // "real_estate" | "vehicle" | "income_source" | "other" | "crypto"
  type           String // apartment | house | commercial | land | garage | car | equipment | salary | dividend | crypto | ...
  // Crypto holdings: coin ticker (e.g. "BTC") + CoinGecko id for live
  // pricing. Quantity and average cost are derived from CryptoTrade.
  symbol         String?
  coingeckoId    String?
  city           String?
  district       String?
  address        String?
  areaSqm        Float? // real estate only — drives market-rent estimate
  estimatedValue Float?
  monthlyIncome  Float? // income_source only — recurring monthly amount (GEL)
  currency       String   @default("GEL")
  status         String   @default("personal_use") // "rented" | "vacant" | "personal_use" | "listed"
  rentalMode     String   @default("long_term") // "long_term" | "daily"
  // Daily-rental pricing: base rate plus weekend/holiday premiums (%).
  // Effective day price = dailyRate × (1 + premium/100).
  dailyRate      Float?
  weekendPct     Float?
  holidayPct     Float?
  unitId         String?  @unique // optional link to an STR Unit (same property)
  // Per-platform listing URLs for this asset's own announcements.
  // Real estate: myhome/ss/airbnb/booking; vehicles: myauto.
  myhomeUrl      String?
  ssUrl          String?
  myautoUrl      String?
  airbnbUrl      String?
  bookingUrl     String?
  // Vehicles: the state plate, used verbatim in geofence notifications.
  plateNumber    String?
  // Digital door key (daily rentals / handovers), sent via WhatsApp.
  doorCode            String?
  doorCodeGeneratedAt DateTime?
  notes          String?
  createdAt      DateTime @default(now())

  operator  Operator         @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  unit      Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  contracts RentalContract[]
  incomes   IncomeRecord[]
  trades    CryptoTrade[]
  gpsDevice GpsDevice?
  geofences Geofence[]
  days      DayEntry[]

  @@index([operatorId])
}

// A single crypto buy or sell on a crypto Asset. Holdings, average buy
// price and P/L are derived from these (lib/crypto/holdings.ts). Prices
// are per-coin in USD (crypto convention).
model CryptoTrade {
  id        String   @id @default(cuid())
  assetId   String
  side      String // "buy" | "sell"
  quantity  Float // coins
  unitPrice Float // USD per coin at the trade
  tradedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, tradedAt])
}

// A long-term rental contract on an asset (apartment lease, car rental...).
model RentalContract {
  id          String   @id @default(cuid())
  assetId     String
  tenantName  String?
  tenantPhone String? // for WhatsApp (door codes, notifications)
  startDate   DateTime
  endDate     DateTime
  monthlyRent Float
  currency    String   @default("GEL")
  deposit     Float?
  status      String   @default("active") // "active" | "upcoming" | "ended"
  notes       String?
  createdAt   DateTime @default(now())

  // ── Payment schedule (car rentals especially) ──
  // The contract says how often the renter pays and how many days late is
  // still tolerated. Past the grace period the owner has the contractual
  // right to take the vehicle back — with graceDays = 3 that is day 4.
  paymentPeriod String    @default("monthly") // "daily" | "weekly" | "monthly"
  paymentAmount Float? // per period; falls back to monthlyRent
  graceDays     Int       @default(3)
  // Paid up to (exclusive): every period starting before this date is
  // settled. Null means nothing paid yet — the schedule starts at startDate.
  paidThrough   DateTime?

  asset    Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  payments RentPayment[]

  @@index([assetId, endDate])
}

// One received payment against a contract. Recording a payment advances
// the contract's paidThrough by the periods it covers.
model RentPayment {
  id         String   @id @default(cuid())
  contractId String
  amount     Float
  currency   String   @default("GEL")
  paidAt     DateTime @default(now())
  // The window this payment settles, so history stays auditable even if
  // the schedule is edited later.
  periodStart DateTime
  periodEnd   DateTime
  method     String   @default("cash") // "cash" | "transfer" | "card" | "other"
  note       String?
  createdAt  DateTime @default(now())

  contract RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, paidAt])
}

// A GPS tracker bound to one asset (the vehicle it is installed in).
// Positions arrive on POST /api/gps/ping authenticated by `token`.
model GpsDevice {
  id        String    @id @default(cuid())
  assetId   String    @unique
  label     String?
  provider  String    @default("generic") // tracker vendor, informational
  deviceId  String    @unique // the tracker's own identifier
  token     String    @unique // shared secret for the ingest endpoint
  lastLat   Float?
  lastLng   Float?
  lastSpeed Float? // km/h, when the tracker reports it
  lastPingAt DateTime?
  createdAt DateTime  @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

// A "red line": the area the vehicle is contractually allowed to stay in.
// Either a circle (center + radiusKm) or a polygon (points: [[lat,lng],…]).
// The driver is warned `approachKm` before the boundary and again on
// crossing it.
model Geofence {
  id         String   @id @default(cuid())
  assetId    String
  name       String
  kind       String   @default("circle") // "circle" | "polygon"
  centerLat  Float?
  centerLng  Float?
  radiusKm   Float?
  points     Json? // polygon: [[lat, lng], …]
  approachKm Float    @default(1)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  asset  Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  events GeoEvent[]

  @@index([assetId, active])
}

// A boundary transition detected from GPS pings. One row per state change,
// so a car sitting just outside the line does not re-notify every minute.
model GeoEvent {
  id         String   @id @default(cuid())
  assetId    String
  geofenceId String
  kind       String // "approach" | "breach" | "return"
  lat        Float
  lng        Float
  distanceKm Float // to the boundary; negative-free, `kind` says which side
  createdAt  DateTime @default(now())

  geofence Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
}

// An operator-editable notification body. Defaults live in code
// (lib/notify/templates.ts); a row exists only once the operator edits it.
model NotifyTemplate {
  id         String   @id @default(cuid())
  operatorId String
  key        String // see TEMPLATE_KEYS in lib/notify/templates.ts
  body       String
  updatedAt  DateTime @default(now()) @updatedAt

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@unique([operatorId, key])
}

// The WhatsApp outbox. Messages are queued the moment an event fires and
// sent by the Cloud API when it is configured; without it they stay
// queued with a click-to-send wa.me link so nothing is silently lost.
model NotifyMessage {
  id         String  @id @default(cuid())
  operatorId String
  assetId    String?
  contractId String?
  toPhone    String // digits only, international
  toRole     String // "driver" | "owner"
  kind       String // template key this was rendered from
  body       String
  status     String  @default("queued") // "queued" | "sent" | "failed"
  // Stable key so a repeated scan or ping never queues the same message twice.
  dedupeKey   String   @unique
  providerRef String?
  error       String?
  createdAt   DateTime @default(now())
  sentAt      DateTime?

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId, status])
}

// One day of a daily-let asset: was it rented, and for how much. The
// suggested amount comes from the asset's day price (base rate plus the
// weekend or holiday premium), but the owner can agree anything and edit
// it afterwards — the agreed figure is what counts, not the tariff.
model DayEntry {
  id        String   @id @default(cuid())
  assetId   String
  date      DateTime // UTC midnight of the day it covers
  rented    Boolean  @default(true)
  amount    Float    @default(0) // agreed amount for that day
  currency  String   @default("GEL")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, date])
  @@index([assetId, date])
}

// A manual income entry (salary, dividend, one-off) — rent and STR income
// are derived from contracts and bookings; this covers everything else.
model IncomeRecord {
  id          String   @id @default(cuid())
  operatorId  String
  assetId     String?
  source      String // "rent" | "str" | "salary" | "business" | "dividend" | "other"
  description String?
  date        DateTime
  amount      Float
  currency    String   @default("GEL")
  createdAt   DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  asset    Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([operatorId, date])
}

// Long-term rent reference per district per month (GEL per m²). Mock for
// the MVP, same compliance stance as MarketBenchmark.
model RentBenchmark {
  id            String @id @default(cuid())
  district      String
  month         String // "YYYY-MM"
  avgRentPerSqm Float
  sampleSize    Int
  source        String @default("mock")

  @@unique([district, month])
}

// A proactive alert with a suggested action in its payload.
model Alert {
  id         String   @id @default(cuid())
  operatorId String
  unitId     String?
  // "vacancy_gap" | "lease_expiry" | "underpriced" | "contract_expiry"
  // | "rent_overdue" | "repossession_right" | "geofence_breach"
  type       String
  payload    Json // type-specific details + { suggestedAction: string }
  status     String    @default("open") // "open" | "dismissed" | "resolved"
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  unit     Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([operatorId, status])
}
