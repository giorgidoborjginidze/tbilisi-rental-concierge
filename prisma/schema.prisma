// Prisma schema — STR / Aparthotel Operator Tool (Phase 1)
//
// Runs on SQLite locally. Kept Postgres-compatible for a later switch:
// no SQLite-only features; enum-like fields are Strings (documented below);
// money is Float for SQLite (switch to Decimal when moving to Postgres).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// The account/customer: a professional STR/aparthotel operator.
model Operator {
  id           String   @id @default(cuid())
  name         String? // optional — display name only; never required
  email        String   @unique
  passwordHash String? // scrypt "salt:hash"; null only for legacy rows
  // The account's language: the UI default and the language of every
  // WhatsApp message sent to its tenants and drivers. Georgian unless the
  // owner switched the app to English.
  locale       String   @default("ka") // "ka" | "en"
  // When the owner chose the language (registration, the language switch,
  // sign-in). Null: never chosen — scripts/backfill-locale.ts may move such
  // rows to Georgian.
  localeSetAt  DateTime?
  createdAt    DateTime @default(now())

  // Billing: 30-day full-access trial from signup, then a paid plan. A plan
  // applies while it is paid: paidUntil (+3 days grace, lib/billing/plans.ts).
  accountType String    @default("personal") // "personal" | "business"
  // Workspace profile: shapes the dashboard and nav.
  profile     String    @default("personal") // "personal" | "hotel" | "brokerage"
  plan        String? // "starter" | "standard" | "pro" | "biz_s" | "biz_m"
  trialEndsAt DateTime?
  planSetAt   DateTime?
  // Subscription paid through this date (set on a successful payment).
  paidUntil   DateTime?

  // Team (business accounts): members belong to an owner's company and
  // enter their own listings; limits are counted company-wide.
  companyId String?
  role      String  @default("owner") // "owner" | "member"
  company   Operator?  @relation("Team", fields: [companyId], references: [id], onDelete: SetNull)
  members   Operator[] @relation("Team")

  // WhatsApp number that receives owner-side alerts (geofence, overdue rent).
  notifyPhone String?
  // How renters pay (bank account, "cash to the office"…): the {pay_to}
  // placeholder of every payment reminder. Free text, shown as typed.
  payInstructions String?

  // The shared public demo (credentials on the landing and login pages):
  // read-only (lib/auth/session.ts requireWriter), never sends WhatsApp
  // messages itself, and keeps its showcase plan without payment.
  isDemo Boolean @default(false)

  units     Unit[]
  alerts    Alert[]
  assets    Asset[]
  incomes   IncomeRecord[]
  sessions  Session[]
  invites   Invite[]
  payments  Payment[]
  templates NotifyTemplate[]
  messages  NotifyMessage[]
  resets    PasswordReset[]

  @@index([companyId])
}

// A subscription payment attempt through a payment provider (Flitt).
// One row per checkout; status advances to "approved" via the provider's
// server callback, which is when the plan is actually activated.
model Payment {
  id          String    @id @default(cuid())
  operatorId  String
  provider    String    @default("flitt")
  plan        String // plan id being purchased
  amountMinor Int // amount in minor units (tetri) — 49 GEL = 4900
  currency    String    @default("GEL")
  // "pending" → "approved" | "declined". Activation happens on "approved".
  status      String    @default("pending")
  orderId     String    @unique // our id sent to the provider
  providerRef String? // provider's payment id (from the callback)
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

// A pending team invitation (business plans). The invite link is
// /register?invite=<token>; no email sending yet — the owner copies it.
// The link only works for the invited email, for 7 days (lib/auth/invite.ts).
model Invite {
  id        String    @id @default(cuid())
  companyId String
  email     String
  token     String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  company Operator @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// A login session; id is the SHA-256 of the cookie token.
model Session {
  id         String   @id
  operatorId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

// A password-reset link (/reset/<token>, sent by email). Like Session, the
// id is the SHA-256 of the token, so the database never holds a usable
// link. Single use (usedAt) and short-lived (expiresAt).
model PasswordReset {
  id         String    @id
  operatorId String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

// A failed sign-in or a reset request, for rate limiting (lib/auth/limit.ts):
// counted per email and per IP over a short window, pruned after a day.
// Holds no password and no session.
model AuthAttempt {
  id        String   @id @default(cuid())
  kind      String // "login" | "reset"
  email     String
  ip        String?
  createdAt DateTime @default(now())

  @@index([kind, email, createdAt])
  @@index([kind, ip, createdAt])
  @@index([createdAt])
}

// A rentable unit (apartment, aparthotel room, studio...).
model Unit {
  id              String   @id @default(cuid())
  operatorId      String
  name            String
  nameKa          String? // Georgian display name
  city            String   @default("Tbilisi") // "Tbilisi" | "Batumi"
  district        String // e.g. "Vake", "Vera", "Saburtalo", "Old Town", "Mtatsminda", "Batumi Boulevard"
  address         String
  type            String // "apartment" | "aparthotel_room" | "studio" | "house"
  capacity        Int
  bedrooms        Int
  baseNightlyRate Float
  currency        String   @default("GEL")
  amenities       Json // string[] of amenity keys
  channelLinks    Json // { airbnbUrl?, bookingUrl?, icalUrls: string[] }
  createdAt       DateTime @default(now())

  operator           Operator            @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  bookings           Booking[]
  leases             Lease[]
  pricingSuggestions PricingSuggestion[]
  alerts             Alert[]
  asset              Asset?
  feeds              UnitFeed[]
  calendarExport     CalendarExport?

  @@index([operatorId])
  @@index([district])
}

// How the last sync of ONE iCal feed of a unit went. The list of feed URLs
// itself stays in Unit.channelLinks.icalUrls; a row is written for each URL
// at every sync (and removed when the owner deletes the URL).
// The unit's own calendar, published for Airbnb / Booking.com to read
// (app/api/ical/[token]): a secret token in the URL, no names in it. A new
// token ("new link") retires the old address at once.
model CalendarExport {
  id        String   @id @default(cuid())
  unitId    String   @unique
  token     String   @unique
  createdAt DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model UnitFeed {
  id            String    @id @default(cuid())
  unitId        String
  url           String
  source        String // "airbnb" | "booking" | "direct"
  lastAttemptAt DateTime?
  lastSyncedAt  DateTime? // last successful fetch
  lastError     String? // FeedError code (lib/ical/fetch.ts); null after a success
  lastStatus    Int? // HTTP status of a failed fetch, when the channel answered
  lastCount     Int? // stays the feed held at the last success
  lastCancelled Int? // stays marked cancelled at the last success (gone from the feed)
  createdAt     DateTime  @default(now())

  unit     Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([unitId, url])
}

// A short-term booking, imported from an iCal feed or entered manually.
// Guest PII kept minimal: guestName is optional (Georgian PDP law / GDPR).
model Booking {
  id         String   @id @default(cuid())
  unitId     String
  source     String // "airbnb" | "booking" | "direct" | "manual"
  guestName  String?
  checkIn    DateTime
  checkOut   DateTime
  nights     Int
  amount     Float?
  currency   String   @default("GEL")
  status     String   @default("confirmed") // "confirmed" | "cancelled" | "tentative"
  externalId String? // UID from the iCal event, used for dedupe
  importedAt DateTime @default(now())
  // The feed that imported it (null: entered by hand, or imported before
  // feeds were tracked). A stay that vanishes from its feed is cancelled.
  feedId       String?
  cancelledAt  DateTime?
  cancelReason String? // "owner" | "channel" (STATUS:CANCELLED) | "missing" (gone from the feed)
  // A Booking.com "CLOSED" event that only repeats nights another stay on
  // the unit already holds (the Airbnb calendar imported into Booking.com):
  // the source of that stay ("airbnb" | "direct" | "manual" | "lease").
  // Kept for the record but left out of revenue, overlaps and the
  // "no price" counts (lib/ical/mirror.ts). Null: a stay in its own right.
  mirrorOf     String?

  unit Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  feed UnitFeed? @relation(fields: [feedId], references: [id], onDelete: SetNull)

  @@unique([unitId, source, externalId])
  @@index([unitId, checkIn])
  @@index([feedId])
}

// A long-stay contract (aparthotel monthly stays / leases).
model Lease {
  id          String   @id @default(cuid())
  unitId      String
  tenantName  String?
  tenantPhone String? // for WhatsApp (door codes, notifications)
  startDate   DateTime
  endDate     DateTime
  monthlyRent Float
  currency    String   @default("GEL")
  status      String   @default("active") // "active" | "ended" | "upcoming"
  createdAt   DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, endDate])
}

// Output of the rule-based pricing engine, one row per unit per date.
model PricingSuggestion {
  id            String   @id @default(cuid())
  unitId        String
  date          DateTime
  suggestedRate Float
  currency      String   @default("GEL")
  reasons       Json // { factors: {...}, rationale: string }
  createdAt     DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, date])
}

// Neighborhood ADR / occupancy reference, per district per month.
// MVP rows are mock data behind the pluggable MarketDataSource interface.
model MarketBenchmark {
  id            String @id @default(cuid())
  district      String
  month         String // "YYYY-MM"
  adr           Float
  occupancyRate Float // 0..1
  sampleSize    Int
  source        String @default("mock")

  @@unique([district, month])
}

// A personal asset: real estate (apartment, house, commercial, land,
// garage) or movable property (vehicle, equipment). Tracks status,
// estimated value, and — via RentalContract — who rents it and until when.
model Asset {
  id             String   @id @default(cuid())
  operatorId     String
  name           String
  nameKa         String?
  category       String // "real_estate" | "vehicle" | "income_source" | "other" | "crypto"
  type           String // apartment | house | commercial | land | garage | car | equipment | salary | dividend | crypto | ...
  // Crypto holdings: coin ticker (e.g. "BTC") + CoinGecko id for live
  // pricing. Quantity and average cost are derived from CryptoTrade.
  symbol         String?
  coingeckoId    String?
  city           String?
  district       String?
  address        String?
  areaSqm        Float? // real estate only — drives market-rent estimate
  estimatedValue Float?
  monthlyIncome  Float? // income_source only — recurring monthly amount (GEL)
  currency       String   @default("GEL")
  status         String   @default("personal_use") // "rented" | "vacant" | "personal_use" | "listed"
  // When the owner last set `status` by hand. A stored "rented" that is
  // older than the end of the asset's last contract is stale: the asset
  // follows its contracts (lib/rentals/phase.ts assetStatusNow).
  statusSetAt    DateTime?
  rentalMode     String   @default("long_term") // "long_term" | "daily"
  // Daily-rental pricing: base rate plus weekend/holiday premiums (%).
  // Effective day price = dailyRate × (1 + premium/100).
  dailyRate      Float?
  weekendPct     Float?
  holidayPct     Float?
  unitId         String?  @unique // optional link to an STR Unit (same property)
  // Per-platform listing URLs for this asset's own announcements.
  // Real estate: myhome/ss/airbnb/booking; vehicles: myauto.
  myhomeUrl      String?
  ssUrl          String?
  myautoUrl      String?
  airbnbUrl      String?
  bookingUrl     String?
  // Vehicles: the state plate, used verbatim in geofence notifications.
  plateNumber    String?
  // Digital door key (daily rentals / handovers), sent via WhatsApp.
  doorCode            String?
  doorCodeGeneratedAt DateTime?
  notes          String?
  createdAt      DateTime @default(now())

  operator  Operator         @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  unit      Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  contracts RentalContract[]
  incomes   IncomeRecord[]
  trades    CryptoTrade[]
  gpsDevice GpsDevice?
  geofences Geofence[]
  days      DayEntry[]

  @@index([operatorId])
}

// A single crypto buy or sell on a crypto Asset. Holdings, average buy
// price and P/L are derived from these (lib/crypto/holdings.ts). Prices
// are per-coin in USD (crypto convention).
model CryptoTrade {
  id        String   @id @default(cuid())
  assetId   String
  side      String // "buy" | "sell"
  quantity  Float // coins
  unitPrice Float // USD per coin at the trade
  tradedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, tradedAt])
}

// A long-term rental contract on an asset (apartment lease, car rental...).
model RentalContract {
  id          String   @id @default(cuid())
  assetId     String
  tenantName  String?
  tenantPhone String? // for WhatsApp (door codes, notifications)
  startDate   DateTime
  endDate     DateTime // exclusive: the day the rental is over (move-out)
  // The NORMALISED monthly equivalent of the rent (daily × 30.44,
  // weekly × 4.345), so every monthly figure — KPIs, income bars, market
  // comparison — adds up. What the renter actually pays per period is
  // paymentAmount.
  monthlyRent Float
  currency    String   @default("GEL")
  deposit     Float?
  // Written for compatibility only; never trusted for logic. The phase is
  // derived from the dates (lib/rentals/phase.ts contractPhase).
  status      String   @default("active") // "active" | "upcoming" | "ended"
  notes       String?
  createdAt   DateTime @default(now())

  // ── Payment schedule ──
  // The contract says how often the renter pays and how many days late is
  // still tolerated. Past the grace period a car owner has the contractual
  // right to take the vehicle back; a landlord may act under the lease.
  paymentPeriod String    @default("monthly") // "daily" | "weekly" | "monthly"
  paymentAmount Float? // per period, as typed — the amount actually charged
  graceDays     Int       @default(3)
  // Paid up to (exclusive), always a period boundary counted from
  // startDate: every period starting before this date is settled. Null
  // means the schedule is not tracked yet (the owner has not said how far
  // the rent is paid), so nothing is announced about it.
  paidThrough   DateTime?
  // Money received that does not cover a whole period yet; it counts
  // toward the next period.
  creditBalance Float     @default(0)
  // Automatic WhatsApp reminders to the renter (the owner still gets alerts).
  remindersEnabled Boolean @default(true)
  // When the owner recorded that the renter agreed to WhatsApp notices
  // (null: not recorded), and when the renter asked to get no more
  // messages (null: no objection). An objection stops every message to the
  // renter, whatever remindersEnabled says (lib/notify/whatsapp.ts).
  waConsentAt      DateTime?
  messagesOptOutAt DateTime?
  // Opening balance of the payment ledger: the paid-up-to date and credit
  // the owner stated at `openingAt`. Payments recorded after `openingAt`
  // are replayed on top of it whenever one of them is deleted.
  openingPaidThrough DateTime?
  openingCredit      Float     @default(0)
  openingAt          DateTime?
  // Deleted by the owner (soft delete): the contract and its payments are
  // kept for the record and for "undo", but every screen, total, alert and
  // reminder leaves it out (lib/rentals/live.ts LIVE_CONTRACT).
  deletedAt          DateTime?

  asset    Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  payments RentPayment[]

  @@index([assetId, endDate])
  @@index([assetId, deletedAt])
}

// One received payment against a contract. Recording a payment advances
// the contract's paidThrough by the whole periods it covers; the rest is
// kept as credit (RentalContract.creditBalance).
model RentPayment {
  id         String   @id @default(cuid())
  contractId String
  amount     Float
  currency   String   @default("GEL")
  paidAt     DateTime @default(now())
  // The window this payment settles, so history stays auditable even if
  // the schedule is edited later.
  periodStart DateTime
  periodEnd   DateTime
  method     String   @default("cash") // "cash" | "transfer" | "card" | "other"
  note       String?
  createdAt  DateTime @default(now())

  contract RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, paidAt])
}

// A GPS tracker bound to one asset (the vehicle it is installed in).
// Positions arrive on POST /api/gps/ping authenticated by `token`.
model GpsDevice {
  id        String    @id @default(cuid())
  assetId   String    @unique
  label     String?
  provider  String    @default("generic") // tracker vendor, informational
  deviceId  String    @unique // the tracker's own identifier
  token     String    @unique // shared secret for the ingest endpoint
  lastLat   Float?
  lastLng   Float?
  lastSpeed Float? // km/h, when the tracker reports it
  lastPingAt DateTime? // the tracker's own time of the last accepted fix
  // Server time of the last accepted ping — the per-device rate limit.
  lastReceivedAt DateTime?
  createdAt DateTime  @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

// A "red line": the area the vehicle is contractually allowed to stay in.
// Either a circle (center + radiusKm) or a polygon (points: [[lat,lng],…]).
// The driver is warned `approachKm` before the boundary and again on
// crossing it.
model Geofence {
  id         String   @id @default(cuid())
  assetId    String
  name       String
  kind       String   @default("circle") // "circle" | "polygon"
  centerLat  Float?
  centerLng  Float?
  radiusKm   Float?
  points     Json? // polygon: [[lat, lng], …]
  approachKm Float    @default(1)
  active     Boolean  @default(true)
  // Where the vehicle stood against this fence at the last accepted ping
  // ("safe" | "approach" | "outside"). Transitions are computed from it, so
  // an approach warning re-arms once the car is back in the safe zone.
  lastZone   String?
  createdAt  DateTime @default(now())

  asset  Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  events GeoEvent[]

  @@index([assetId, active])
}

// A boundary transition detected from GPS pings. One row per state change,
// so a car sitting just outside the line does not re-notify every minute.
model GeoEvent {
  id         String   @id @default(cuid())
  assetId    String
  geofenceId String
  kind       String // "approach" | "breach" | "return"
  lat        Float
  lng        Float
  distanceKm Float // to the boundary; negative-free, `kind` says which side
  createdAt  DateTime @default(now())

  geofence Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
}

// An operator-editable notification body. Defaults live in code
// (lib/notify/templates.ts); a row exists only once the operator edits it.
model NotifyTemplate {
  id         String   @id @default(cuid())
  operatorId String
  key        String // see TEMPLATE_KEYS in lib/notify/templates.ts
  body       String
  updatedAt  DateTime @default(now()) @updatedAt

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@unique([operatorId, key])
}

// The WhatsApp outbox. Messages are queued the moment an event fires and
// sent by the Cloud API when it is configured; without it they stay
// queued with a click-to-send wa.me link so nothing is silently lost.
model NotifyMessage {
  id         String  @id @default(cuid())
  operatorId String
  assetId    String?
  contractId String?
  toPhone    String // digits only, international
  toRole     String // "driver" | "tenant" | "owner"
  kind       String // template key this was rendered from
  body       String
  // "cancelled": withdrawn before it went out because what it said no longer
  // holds — the rent was paid, the contract changed or ended, the vehicle
  // came back inside the red line. It is kept (not deleted) so the owner
  // sees why, and so the dedupe key still stops a repeat.
  // "sending": claimed by one delivery run, so two runs never send it twice.
  status     String  @default("queued") // "queued" | "sending" | "sent" | "failed" | "cancelled"
  // Stable key so a repeated scan or ping never queues the same message twice.
  dedupeKey   String   @unique
  providerRef String?
  error       String?
  createdAt   DateTime @default(now())
  sentAt      DateTime?
  // When a delivery run claimed it (status "sending").
  claimedAt   DateTime?
  cancelledAt  DateTime?
  // "paid" | "changed" | "contract_ended" | "contract_deleted" | "returned"
  // | "moved_away" | "newer_reminder" | "fence_removed" | "fence_off"
  // | "asset_deleted" | "limit" | "limit_fence" (lib/rentals/settle.ts WithdrawReason)
  cancelReason String?

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId, status])
  @@index([toPhone, createdAt])
}

// One day of a daily-let asset: was it rented, and for how much. The
// suggested amount comes from the asset's day price (base rate plus the
// weekend or holiday premium), but the owner can agree anything and edit
// it afterwards — the agreed figure is what counts, not the tariff.
model DayEntry {
  id        String   @id @default(cuid())
  assetId   String
  date      DateTime // UTC midnight of the day it covers
  rented    Boolean  @default(true)
  amount    Float    @default(0) // agreed amount for that day
  currency  String   @default("GEL")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, date])
  @@index([assetId, date])
}

// A manual income entry (salary, dividend, one-off) — rent and STR income
// are derived from contracts and bookings; this covers everything else.
model IncomeRecord {
  id          String   @id @default(cuid())
  operatorId  String
  assetId     String?
  source      String // "rent" | "str" | "salary" | "business" | "dividend" | "other"
  description String?
  date        DateTime
  amount      Float
  currency    String   @default("GEL")
  createdAt   DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  asset    Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([operatorId, date])
}

// Long-term rent reference per district per month (GEL per m²). Mock for
// the MVP, same compliance stance as MarketBenchmark.
model RentBenchmark {
  id            String @id @default(cuid())
  district      String
  month         String // "YYYY-MM"
  avgRentPerSqm Float
  sampleSize    Int
  source        String @default("mock")

  @@unique([district, month])
}

// A proactive alert with a suggested action in its payload.
model Alert {
  id         String   @id @default(cuid())
  operatorId String
  unitId     String?
  // "vacancy_gap" | "lease_expiry" | "underpriced" | "contract_expiry"
  // | "contract_ended" | "rent_overdue" | "repossession_right"
  // | "geofence_breach" | "tracker_silent" | "overlap"
  type       String
  payload    Json // type-specific details + { suggestedAction: string }
  status     String    @default("open") // "open" | "dismissed" | "resolved"
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  unit     Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([operatorId, status])
}

// One run of the automatic jobs (Vercel Cron → /api/cron, or the local
// scheduler): iCal sync, the alert scan and WhatsApp delivery for every
// workspace. /alerts shows when it last ran, so a silent failure is seen.
model SystemRun {
  id         String    @id @default(cuid())
  kind       String // "daily" (sync + scan + send) | "sync" (iCal only)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  // Counts, plus the ids of workspaces whose part failed (no personal data).
  summary    Json?

  @@index([kind, startedAt])
}

// The last good price of a holding's symbol — and the USD→GEL rate — shared
// by every workspace. A price API that fails or hangs never makes a holding
// worthless: the page shows this price with its age instead. Not personal
// data (a market price), so it has no operator.
model PriceQuote {
  // "crypto:<coingecko id>" | "stock:<TICKER>" | "metal:<XAU…>" | "fx:USDGEL"
  key       String   @id
  price     Float // USD per unit (fx: GEL per USD)
  source    String   @default("") // "coingecko" | "finnhub" | "stooq" | "gold-api" | "nbg"
  fetchedAt DateTime // when the source last answered with this price
}
