# Copy to .env and fill in.

# Local SQLite database (path relative to the project root).
DATABASE_URL="file:./prisma/dev.db"

# Anthropic API key for pricing-suggestion rationales and the ops assistant.
# Optional: if missing, the app falls back to a deterministic local stub.
ANTHROPIC_API_KEY=""

# Finnhub API key for live stock prices (free tier at https://finnhub.io).
# Optional: if missing, stock prices fall back to Stooq (less reliable from
# cloud hosts). Crypto prices don't use this — they come from CoinGecko.
FINNHUB_API_KEY=""

# Flitt (payment gateway) merchant credentials:
#   FLITT_MERCHANT_ID  — your merchant id
#   FLITT_SECRET_KEY   — your merchant secret (keep private, never commit)
#   FLITT_CURRENCY     — "GEL" for a Georgian merchant
# Locally, without them, the app uses Flitt's public sandbox (merchant
# 1396424 / "test", currency USD) so the checkout flow is testable. On a
# production deployment (VERCEL_ENV=production, or NODE_ENV=production on
# Vercel) missing keys turn checkout OFF with a clear message — it never
# falls back to the free sandbox. A Vercel preview may opt into the sandbox
# with FLITT_SANDBOX="1" (ignored on production).
FLITT_MERCHANT_ID=""
FLITT_SECRET_KEY=""
FLITT_CURRENCY=""
FLITT_SANDBOX=""

# Transactional email (password-reset links) through Resend
# (https://resend.com). Both are needed; without them /forgot says that
# reset by email is not switched on yet and points to the support address.
#   RESEND_API_KEY — the API key (keep private, never commit)
#   EMAIL_FROM     — a sender on a domain verified in Resend,
#                    e.g. "Activo <no-reply@activo.world>"
RESEND_API_KEY=""
EMAIL_FROM=""

# How often the local scheduler (npm run scheduler) runs the iCal sync.
SYNC_INTERVAL_MINUTES="60"

# Secret for the automatic daily job (Vercel Cron → GET /api/cron): iCal
# sync, the alert scan and WhatsApp delivery for every workspace. Set a
# random string of 16+ characters in the Vercel project; Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>". While it is empty the route
# refuses every call. Generate one with: openssl rand -hex 32
CRON_SECRET=""

# Canonical public URL, used for SEO metadata, robots.txt and sitemap.xml.
# Set this in Vercel once a custom domain is connected, e.g.
#   NEXT_PUBLIC_SITE_URL="https://activo.world"
# If unset, it falls back to Vercel's production URL automatically (and to
# http://localhost:3000 in local development), so it's optional.
NEXT_PUBLIC_SITE_URL=""

# WhatsApp Business Cloud API (Meta), for sending rental notifications
# automatically. Optional: without these the messages still appear in the
# outbox with a one-tap wa.me send link, so nothing is lost.
#   WHATSAPP_TOKEN            — permanent access token for the system user
#   WHATSAPP_PHONE_NUMBER_ID  — the sending number's id in Meta Business
#   WHATSAPP_TEMPLATE_NAME    — an approved template with one body parameter
#   WHATSAPP_TEMPLATE_LOCALE  — that template's language code, e.g. "ka"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LOCALE=""

# Error alerting (optional). An https incoming-webhook URL (Slack, Discord,
# Teams, or any endpoint taking JSON): every server error is posted there
# as well as logged (instrumentation.ts) — at most once a minute per route.
ERROR_WEBHOOK_URL=""

# Self-hosting behind your own reverse proxy (not Vercel): set to 1 only when
# the proxy overwrites X-Real-IP / X-Forwarded-For, so the per-address
# sign-in limits can trust them (lib/auth/limit.ts). Leave empty otherwise.
TRUST_PROXY_HEADERS=""
# Error monitoring (optional): a Sentry project's DSN. Server, edge and
# browser errors go there, scrubbed of cookies, headers, query strings and
# reset tokens (lib/observability/sentry.ts). Production builds only.
NEXT_PUBLIC_SENTRY_DSN=""
# Database backups on Neon (optional): an API key from the Neon console
# (Account or Organization settings → API keys). The daily run and every
# production deploy then take a snapshot (lib/backup/neon-snapshot.ts). The
# project id comes from DATABASE_NEON_PROJECT_ID, set by the Vercel–Neon
# integration; NEON_PROJECT_ID overrides it elsewhere.
NEON_API_KEY=""

# Owner notifications on phones and browsers (Web Push, lib/notify/owner.ts).
# Generate a pair once with `npx web-push generate-vapid-keys`. The public key
# is sent to browsers; the private key stays secret (Vercel → Sensitive).
# Without them Settings says phone notifications are not ready yet; email
# alerts still go out through Resend (RESEND_API_KEY / EMAIL_FROM above).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="https://activo.world"

# Documents and photos (lib/files/store.ts): a private Vercel Blob store.
# Connecting the store to the project in Vercel (Storage → Blob) sets this.
# On a developer machine without it, FILES_LOCAL_DIR keeps files in a folder.
BLOB_READ_WRITE_TOKEN=""
FILES_LOCAL_DIR=""

# Seals secrets the owners give us — their own WhatsApp Business access
# token (lib/security/secret.ts). 32 random bytes: `openssl rand -base64 32`.
# Keep it Sensitive in Vercel; changing it makes saved tokens unreadable
# (owners would connect their number again).
SECRETS_KEY=""

# Activo's admins (comma-separated sign-in emails): who may enter market
# data on /admin/market (reports, listing imports). Anyone else gets a 404.
ADMIN_EMAILS=""
